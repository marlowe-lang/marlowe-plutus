cabal-version: 3.4
name:          marlowe-web
version:       0.1.0.0
license:       Apache-2.0
build-type:    Simple
maintainer:    paluh (aka Tomasz Rybarczyk)
stability:     experimental
author:        Based on marlowe-runtime-web by Jamie Bertram
synopsis:      Self-contained Marlowe Runtime Web API
category:      Language
license-files:
  LICENSE
  NOTICE

source-repository head
  type:     git
  location: https://github.com/marlowe-lang/marlowe-plutus

common lang
  default-language:   Haskell2010
  default-extensions:
    BangPatterns
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DoAndIfThenElse
    ExplicitForAll
    FlexibleContexts
    FlexibleInstances
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NumericUnderscores
    OverloadedStrings
    PatternSynonyms
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    ViewPatterns

  ghc-options:
    -Wall -Wnoncanonical-monad-instances
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wredundant-constraints -Widentities -Werror

library
  import:          lang
  hs-source-dirs:  src
  build-depends:
    , aeson
    , base
    , bytestring
    , cardano-api
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-core
    , containers
    , deepseq
    , errors
    , hashable
    , lens
    , marlowe-plutus ^>=0.2
    , network-uri
    , nonempty-containers
    , ouroboros-consensus
    , ouroboros-network-api
    , plutus-core ^>=1.57
    , plutus-ledger-api ^>=1.57
    , plutus-tx ^>=1.57
    , scientific
    , semialign
    , semigroups
    , text
    , time
    , transformers
    , unordered-containers
    , vector

  exposed-modules:
    Language.Marlowe.Runtime.Web.Core.Address
    Language.Marlowe.Runtime.Web.Core.Base16
    Language.Marlowe.Runtime.Web.Core.BlockHeader
    Language.Marlowe.Runtime.Web.Core.MarloweVersion
    Language.Marlowe.Runtime.Web.Core.NetworkId
    Language.Marlowe.Runtime.Web.Core.Semantics.Schema
    Language.Marlowe.Runtime.Web.Runtime.Types
