-- run `nix flake lock --update-input hackage` after updating the hackage index-state.
-- run `nix flake lock --update-input CHaP` after updating the cardano-haskell-packages index-state.
index-state:
  , hackage.haskell.org 2026-01-09T08:43:32Z
  , cardano-haskell-packages 2026-04-03T08:05:29Z

packages:
  marlowe-binaries
  marlowe-plutus
  marlowe-transactions
  libs/base16-aeson
  libs/multiplate
  -- libs/sqlite-simple

tests: True

test-show-details: direct

-- Let's keep alphabetical order of packages below.

package marlowe-plutus
  tests: True
  ghc-options: -Werror

constraints:
    cardano-api ^>=10.23
  , plutus-core ^>=1.57
  , plutus-ledger-api ^>=1.57

source-repository-package
   type: git
   location: https://github.com/marlowe-lang/marlowe
   tag: 2a5a03fbff15fd0469b89a65a56cc17e89be2acc
   subdir: marlowe-spec-test
           haskell
           isabelle
   --sha256: sha256-DmjFaROtuxyoVOOdTIYh28evqaa7ZbQyzkaJUTZMcxI=


