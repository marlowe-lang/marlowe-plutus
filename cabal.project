-- run `nix flake lock --update-input hackage` after updating the hackage index-state.
-- run `nix flake lock --update-input CHaP` after updating the cardano-haskell-packages index-state.
-- We duplicate the hackage index-state first for haskell.nix, even though cabal ignores it.
-- This must always match the hackage index-state on the next line.
-- See https://github.com/input-output-hk/haskell.nix/issues/1869#issuecomment-1449272480
index-state:
  , hackage.haskell.org 2026-01-09T08:43:32Z
  , cardano-haskell-packages 2026-01-08T17:40:53Z

-- Package list of cardano-haskell-packages has been updated.
-- The index-state is set to 2026-01-08T17:40:53Z.
-- To revert to previous state run:
--     cabal v2-update 'cardano-haskell-packages,2026-01-02T09:17:25Z'
-- Package list of hackage.haskell.org has been updated.
-- The index-state is set to 2026-01-09T08:43:32Z.
-- To revert to previous state run:
--     cabal v2-update 'hackage.haskell.org,2026-01-03T05:41:55Z'

packages:
  marlowe-binaries
  marlowe-plutus
  marlowe-transactions
  libs/base16-aeson
  libs/multiplate
  -- libs/sqlite-simple

tests: True

test-show-details: direct

-- Let's keep alphabetical order of packages below.

package marlowe-plutus
  tests: True
  ghc-options: -Werror


constraints:
    cardano-api ^>=10.16
  , plutus-core ==1.45.0.0
  , plutus-ledger-api ==1.45.0.0

source-repository-package
   type: git
   location: https://github.com/marlowe-lang/marlowe
   tag: 2a5a03fbff15fd0469b89a65a56cc17e89be2acc
   subdir: marlowe-spec-test
           haskell
           isabelle
   --sha256: sha256-DmjFaROtuxyoVOOdTIYh28evqaa7ZbQyzkaJUTZMcxI=


